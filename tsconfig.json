{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "moba/**/*.ts",
    "combat/**/*.ts",
    "engine/**/*.ts",
    "entity/**/*.ts",
    "prayer/**/*.ts",
    "world/**/*.ts"
  ]
}
